# Only machine-specific runtimes, installs, build output and secrets are ignored.
# Everything else (source, content, .undo, .impeccable, design-assets, docs) is committed.

# portable runtime + caches (venv-style)
/.node/
/.npm-cache/

# dependencies (restore with `npm install`)
/node_modules/

# build output (regenerated by `npm run dev` / `npm run build`)
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# secrets
.env*.local

# OS / tool noise
.DS_Store
Thumbs.db
npm-debug.log*
.vercel
